{
  "name": "psi-swarm",
  "version": "0.4.2",
  "description": "Run Lighthouse N times across realistic device/network presets. Get p50/p75/p90/p99 of your Web Vitals instead of a single noisy number.",
  "type": "module",
  "bin": {
    "psi-swarm": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=75 --test-coverage-branches=79 --test-coverage-functions=66 test/**/*.test.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22.19 <25"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "ai": "6.0.168",
    "better-sqlite3": "11.10.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "chrome-launcher": "1.2.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ink": "^7.0.5",
    "lighthouse": "13.4.1",
    "ora": "^8.1.1",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "lighthouse",
    "pagespeed",
    "performance",
    "web-vitals",
    "cli",
    "p99",
    "core-web-vitals"
  ],
  "author": "Sarthak Agrawal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sass-maker/psi-swarm.git",
    "directory": "cli"
  },
  "homepage": "https://performance.sassmaker.com",
  "bugs": {
    "url": "https://github.com/sass-maker/psi-swarm/issues"
  }
}
